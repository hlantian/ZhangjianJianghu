#class=YRoom
begin of YPropertyGroup
string values:
名字=磨镜台
描述=@LONG
    这里是磨镜台。磨镜台和半山亭隔壑相望，登磨镜台远望，南岳景色尽收眼底，台旁古松盘桓，台前壑谷幽深。<br>
    这里明显的出口是<a href='javascript:sendmsg("n")'>北</a>、<a href='javascript:sendmsg("wu")'>西上</a>、<a href='javascript:sendmsg("su")'>南上</a>。
LONG
北=半山亭
西上=芙蓉峰
南上=燕子岩
long values:
float values:
end of YPropertyGroup
begin of YObjectGroup
end of YObjectGroup