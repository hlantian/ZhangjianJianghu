#class=YRoom
begin of YPropertyGroup
string values:
名字=金龙峡口
描述=@LONG
    这里是金龙峡口。金龙峡峡谷幽深，峭壁侧立，石夹青天。<br>
    这里明显的出口是 <a href='javascript:sendmsg("s")'>南</a>、<a href='javascript:sendmsg("eu")'>东上</a>、<a href='javascript:sendmsg("wu")'>西上</a>。
LONG
西上=望岳亭
南=恒山脚下
东上=悬空寺
long values:
float values:
end of YPropertyGroup

