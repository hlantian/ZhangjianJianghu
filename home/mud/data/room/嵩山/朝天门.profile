#class=YRoom
begin of YPropertyGroup
string values:
名字=朝天门
描述=@LONG
    这是嵩山的朝天门，正向上行，陡见双峰中断，天然现出一个门户，疾风从断绝处吹出，云雾随风扑面而至。<br>
    这里明显的出口是<a href='javascript:sendmsg("nw")'>西北</a>、<a href='javascript:sendmsg("sd")'>南下</a>。
LONG
西北=山路
南下=小铁梁峡
NPC列表=陆柏
long values:
